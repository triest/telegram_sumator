# Telegram API credentials (get from https://my.telegram.org)
TG_API_ID=123456
TG_API_HASH=your_api_hash_here
TG_PHONE=+10000000000
# Optional: custom session file name/path
TG_SESSION=session/telegram_digest

# Proxy for connecting to Telegram (needed e.g. in Russia, where Telegram
# is often blocked without one).
#
# By default this is auto-detected on Windows: if you have a proxy/VPN
# app configured under Windows Settings -> Network -> Proxy (or Internet
# Options), the app picks it up automatically -- no need to set anything
# below. You'll see a line like "Auto-detected system proxy (...)" in the
# console on startup when this kicks in.
#
# Only fill in TG_PROXY_* below if auto-detect doesn't work for your setup
# (e.g. a proxy that ISN'T registered as the Windows system proxy, or
# you're on Termux/Linux/macOS where auto-detect isn't implemented yet).
# Setting these here always overrides auto-detection.
#
# Use the SAME proxy you'd configure in Telegram Desktop / mobile app
# (Settings -> Data and Storage -> Proxy). A SOCKS5 proxy is the most
# common and reliable choice; MTProto proxies (tg://proxy?... links) are
# NOT supported here, only plain SOCKS5/SOCKS4/HTTP.
#
# TG_PROXY_TYPE=socks5
# TG_PROXY_HOST=127.0.0.1
# TG_PROXY_PORT=1080
# TG_PROXY_USERNAME=
# TG_PROXY_PASSWORD=
